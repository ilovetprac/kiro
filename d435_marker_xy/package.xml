<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>d435_marker_xy</name>
  <version>0.1.0</version>
  <description>
    ROS 2 Humble node that publishes an ArUco marker's X,Y position (mm)
    relative to an Intel RealSense D435, using the depth + infrared streams
    only (no RGB). Marker center = origin (0,0).
  </description>
  <maintainer email="ilovetprac@users.noreply.github.com">ilovetprac</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <!-- pyrealsense2 and opencv-contrib-python are installed via pip3 on the Pi
       (not available as rosdep keys), so they are not listed here. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
